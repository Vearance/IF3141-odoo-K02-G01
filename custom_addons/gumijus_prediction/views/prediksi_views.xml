<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prediksi_list" model="ir.ui.view">
        <field name="name">gumijus.prediksi.list</field>
        <field name="model">gumijus.prediksi</field>
        <field name="arch" type="xml">
            <tree string="Proses Prediksi">
                <field name="name"/>
                <field name="periode_mulai"/>
                <field name="periode_selesai"/>
                <field name="id_cabang"/>
                <field name="versi_model"/>
                <field name="tanggal_jalan"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'selesai'"
                       decoration-warning="status == 'proses'"
                       decoration-info="status == 'draft'"/>
            </tree>
        </field>
    </record>

    <record id="view_prediksi_form" model="ir.ui.view">
        <field name="name">gumijus.prediksi.form</field>
        <field name="model">gumijus.prediksi</field>
        <field name="arch" type="xml">
            <form string="Jalankan Prediksi">
                <header>
                    <button name="action_jalankan" type="object" string="Jalankan Prediksi"
                            class="btn-primary" invisible="status == 'selesai'"/>
                    <button name="action_lihat_rekomendasi" type="object"
                            string="Lihat Rekomendasi"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,proses,selesai"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nama proses prediksi"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="periode_mulai"/>
                            <field name="periode_selesai"/>
                            <field name="id_cabang" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="versi_model"/>
                            <field name="tanggal_jalan"/>
                        </group>
                    </group>
                    <group>
                        <field name="catatan"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Prediksi menggunakan dataset penjualan dan cuaca yang telah divalidasi.
                        Rekomendasi pengadaan dihitung dari estimasi kebutuhan dikurangi stok saat ini
                        dan tidak pernah bernilai negatif.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prediksi" model="ir.actions.act_window">
        <field name="name">Jalankan Prediksi</field>
        <field name="res_model">gumijus.prediksi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada proses prediksi</p>
            <p>Pilih periode dan cabang, lalu jalankan model prediksi kebutuhan bahan baku.</p>
        </field>
    </record>

    <record id="view_rekomendasi_list" model="ir.ui.view">
        <field name="name">gumijus.rekomendasi.list</field>
        <field name="model">gumijus.rekomendasi</field>
        <field name="arch" type="xml">
            <tree string="Rekomendasi Pengadaan" create="false" edit="false">
                <header>
                    <button name="action_export" type="object"
                            string="Ekspor Rekomendasi (CSV)" class="btn-primary"/>
                </header>
                <field name="periode"/>
                <field name="id_cabang"/>
                <field name="nama_bahan" string="Bahan Baku"/>
                <field name="estimasi_kebutuhan" string="Kebutuhan" sum="Total Estimasi Kebutuhan"/>
                <field name="stok_saat_ini" string="Stok Saat Ini" sum="Total Stok"/>
                <field name="rek_pengadaan" string="Rekomendasi" sum="Total Rekomendasi"/>
                <field name="satuan"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'kurang'"
                       decoration-success="status == 'cukup'"/>
            </tree>
        </field>
    </record>

    <record id="view_rekomendasi_form" model="ir.ui.view">
        <field name="name">gumijus.rekomendasi.form</field>
        <field name="model">gumijus.rekomendasi</field>
        <field name="arch" type="xml">
            <form string="Rekomendasi Pengadaan" create="false" edit="false">
                <header>
                    <button name="action_export" type="object"
                            string="Ekspor Rekomendasi (CSV)" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="id_bahan"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="periode"/>
                            <field name="id_cabang"/>
                            <field name="id_bahan"/>
                            <field name="prediksi_id"/>
                        </group>
                        <group>
                            <field name="est_porsi_terjual"/>
                            <field name="estimasi_kebutuhan"/>
                            <field name="stok_saat_ini"/>
                            <field name="rek_pengadaan"/>
                            <field name="satuan"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rekomendasi" model="ir.actions.act_window">
        <field name="name">Rekomendasi Pengadaan</field>
        <field name="res_model">gumijus.rekomendasi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada rekomendasi pengadaan</p>
            <p>Jalankan prediksi untuk menghasilkan rekomendasi kebutuhan pasokan bahan baku.</p>
        </field>
    </record>
</odoo>
