<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_gumijus" model="ir.module.category">
        <field name="name">Gumijus</field>
        <field name="description">Peran pengguna pada sistem Gumijus</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_gumijus_staf" model="res.groups">
        <field name="name">Staf Cabang (JB-04)</field>
        <field name="category_id" ref="module_category_gumijus"/>
    </record>
    <record id="group_gumijus_pjo" model="res.groups">
        <field name="name">Penanggung Jawab Operasional (JB-02)</field>
        <field name="category_id" ref="module_category_gumijus"/>
    </record>
    <record id="group_gumijus_cofounder" model="res.groups">
        <field name="name">Co-founder (JB-01)</field>
        <field name="category_id" ref="module_category_gumijus"/>
    </record>
    <record id="group_gumijus_pengembang" model="res.groups">
        <field name="name">Pengembang Model Prediksi (JB-05)</field>
        <field name="category_id" ref="module_category_gumijus"/>
    </record>

    <record id="rule_stok_harian_cabang" model="ir.rule">
        <field name="name">Stok Harian - Hanya Cabang Sendiri</field>
        <field name="model_id" ref="model_gumijus_stok_harian"/>
        <field name="domain_force">[('id_cabang', '=', user.gumijus_cabang_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gumijus_staf'))]"/>
    </record>

    <record id="rule_rekap_stok_cabang" model="ir.rule">
        <field name="name">Rekap Stok - Hanya Cabang Sendiri</field>
        <field name="model_id" ref="model_gumijus_rekap_stok"/>
        <field name="domain_force">[('id_cabang', '=', user.gumijus_cabang_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_gumijus_staf'))]"/>
    </record>
</odoo>
